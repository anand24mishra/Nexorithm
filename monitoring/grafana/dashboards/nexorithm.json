{
  "uid": "nexorithm",
  "title": "Nexorithm Judge",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nx_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nx_http_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Submissions/s",
      "description": "Rate of the process-local submission counter. It resets when the API restarts and is not a lifetime total.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nx_submissions_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(nx_queue_depth)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Worker active jobs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(nx_worker_active)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Execution p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nx_execution_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nx_http_requests_total{status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Timeouts/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nx_verdicts_total{verdict=\"Time Limit Exceeded\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Worker available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"worker\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Queue wait p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nx_queue_wait_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Worker failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nx_worker_failures_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Sandbox cleanup failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nx_sandbox_cleanup_failures_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Stored submissions",
      "description": "MongoDB document count. This survives API and worker restarts. Do not add it to the process-local submissions counter.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 48, "w": 8, "h": 6},
      "targets": [{"expr": "max(nx_submissions_persisted)", "refId": "A"}]
    },
    {
      "id": 14,
      "title": "Process start",
      "description": "Prometheus default metric. A new timestamp means that process's counters started again.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 48, "w": 8, "h": 6},
      "targets": [{"expr": "max(process_start_time_seconds)", "refId": "A"}]
    },
    {
      "id": 15,
      "title": "Sandboxes reaped/s",
      "description": "Containers removed by the worker or the independent reaper. A SIGKILL does not run the worker finally block; this series shows the reaper path.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 48, "w": 8, "h": 6},
      "targets": [{"expr": "sum(rate(nx_sandboxes_reaped_total[5m]))", "refId": "A"}]
    }
  ]
}
