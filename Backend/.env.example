PORT=8000
NODE_ENV=development
USE_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017/nexorithm
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:5173
METRICS_TOKEN=replace-with-an-independent-random-token
SANDBOX_RUNTIME=runsc
ALLOW_WEAK_SANDBOX=false
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MEMORY_MB=256
EXECUTION_CPUS=1
EXECUTION_MAX_OUTPUT=1048576
EXECUTION_PIDS=32
WORKER_CONCURRENCY=2
MAX_PENDING_SUBMISSIONS=1000
PYTHON_IMAGE=python:3.12.10-slim-bookworm
JAVASCRIPT_IMAGE=node:22.15.0-bookworm-slim
