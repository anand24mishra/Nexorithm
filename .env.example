# Copy to .env; generate independent random values (openssl rand -hex 32).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
METRICS_TOKEN=replace-with-an-independent-random-token
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:8080
SANDBOX_RUNTIME=runsc
ALLOW_WEAK_SANDBOX=false
DOCKER_GID=999
DOCKER_SOCKET=/var/run/docker.sock
WORKER_CONCURRENCY=2
GRAFANA_PASSWORD=replace-with-a-random-dashboard-password
# Optional host binds when 8080 or 3000 is already taken. Defaults match the documented URLs.
# FRONTEND_BIND=8080
# GRAFANA_BIND=3000
